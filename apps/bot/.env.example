NODE_ENV=development

# Bot token от @BotFather. Обязательно для запуска.
TELEGRAM_BOT_TOKEN=

# Postgres (тот же, что у API)
DATABASE_URL=postgres://deadspin:deadspin@localhost:5432/deadspin

# URL Mini App (куда ведёт кнопка "Играть"). В dev без ngrok кнопка работать не будет,
# но бот всё равно стартанёт; кнопка игра — это единственная фича, требующая https.
WEB_APP_URL=https://example.com/play

# Режим доставки апдейтов: 'polling' (dev) или 'webhook' (prod).
BOT_MODE=polling

# Только для webhook-режима:
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=3002

# ALLOWLIST_OPEN=1 означает "в dev пускать всех и автоматически добавлять в allowlist".
# В prod всегда 0 — вход только по заранее добавленным tgId.
ALLOWLIST_OPEN=1
