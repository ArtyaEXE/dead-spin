{
	"name": "@dead-spin/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"start": "node --env-file=.env --import tsx src/index.ts",
		"start:prod": "node --import tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate-db.ts",
		"db:studio": "drizzle-kit studio",
		"migrate:mongo": "tsx scripts/migrate-from-mongo.ts"
	},
	"dependencies": {
		"@dead-spin/db": "workspace:*",
		"@dead-spin/shared": "workspace:*",
		"@hono/node-server": "^1.13.2",
		"drizzle-orm": "^0.36.0",
		"hono": "^4.6.5",
		"postgres": "^3.4.4",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.7.5",
		"drizzle-kit": "^0.28.0",
		"mongodb": "^6.10.0",
		"tsx": "^4.19.1",
		"typescript": "^5.6.3",
		"vitest": "^2.1.2"
	}
}
