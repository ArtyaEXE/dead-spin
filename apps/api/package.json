{
	"name": "@dead-spin/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsup",
		"start": "node --env-file=.env dist/index.js",
		"start:prod": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate-db.ts",
		"db:migrate:prod": "node dist/migrate.js",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@dead-spin/db": "workspace:*",
		"@dead-spin/levels": "workspace:*",
		"@dead-spin/shared": "workspace:*",
		"@hono/node-server": "^1.19.17",
		"@sentry/node": "^10.75.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.8",
		"postgres": "^3.4.4",
		"posthog-node": "^5.52.4",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.20.3",
		"drizzle-kit": "^0.31.10",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "^5.6.3",
		"vitest": "^2.1.2"
	}
}
