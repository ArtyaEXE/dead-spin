NODE_ENV=development
PORT=3001

# Postgres (совпадает с docker-compose.yml в корне репо)
DATABASE_URL=postgres://deadspin:deadspin@localhost:5432/deadspin

# JWT: для prod задай строку длиной ≥32 байта. В dev дефолт уже задан в config.ts.
JWT_SECRET=change-me-in-production-at-least-32-bytes-long

# Telegram bot token — нужен для валидации initData (HMAC-SHA256).
TELEGRAM_BOT_TOKEN=

# TEST=1 включает приём fake-user логина (tgId + password) для локалки.
TEST=0
FAKE_USER_PASSWORD=

# Mongo URI — используется только скриптом migrate:mongo при разовом переносе.
MONGO_URL=mongodb://localhost:27017/meteor

# CORS: через запятую. Для dev можно оставить *.
CORS_ORIGINS=*
