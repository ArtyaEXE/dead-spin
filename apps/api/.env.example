NODE_ENV=development
PORT=3001

# Postgres (совпадает с docker-compose.yml в корне репо)
DATABASE_URL=postgres://deadspin:deadspin@localhost:5432/deadspin

# JWT: для prod задай строку длиной >=32 байта. В dev дефолт уже задан в config.ts.
JWT_SECRET=change-me-in-production-at-least-32-bytes-long

# CORS: через запятую. Для dev можно оставить *.
CORS_ORIGINS=*
